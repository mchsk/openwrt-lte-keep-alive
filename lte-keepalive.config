config keepalive 'main'
	option enabled '1'

	# Network interface to restart on failure (e.g. wwan, wwan0, lte)
	option interface 'wwan'

	# Space-separated list of IPs to ping. Connectivity is OK if ANY responds.
	option ping_targets '8.8.8.8 1.1.1.1 9.9.9.9'

	# Number of ICMP packets per target
	option ping_count '3'

	# Seconds to wait for a ping reply
	option ping_timeout '5'

	# Seconds between connectivity checks
	option check_interval '120'

	# Restart the interface after this many consecutive failures
	option restart_threshold '3'

	# Reboot the router after this many consecutive failures
	option reboot_threshold '9'

	# Seconds to wait between ifdown and ifup
	option restart_delay '15'
